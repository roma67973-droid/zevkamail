# Website worker. Copy to wrangler.toml (it is git-ignored), then:
#   npx wrangler secret put API_KEY         -> same value as in packages/cloudflare
#   npx wrangler secret put SITE_PASSWORD   -> password for the whole site
#   npm run deploy:cloudflare
name = "cloakmail-web"
main = ".svelte-kit/cloudflare/_worker.js"
compatibility_date = "2025-01-01"
compatibility_flags = ["nodejs_compat"]
preview_urls = false

# Optional: serve the site on your own domain (the zone must be in Cloudflare).
# routes = [{ pattern = "mail.example.com", custom_domain = true }]
# Keep the *.workers.dev address as well:
workers_dev = true

[assets]
directory = ".svelte-kit/cloudflare"
binding = "ASSETS"

[vars]
PUBLIC_APP_NAME = "zevkamail"
PUBLIC_EMAIL_DOMAIN = "example.com"

# /api/* is proxied to the API worker through this binding (the key never reaches the browser).
[[services]]
binding = "API"
service = "cloakmail-api"
